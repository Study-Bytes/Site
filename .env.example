# Site must communicate only with BFF.
# Do not add CourseService/UserService/LearningService/CodeExecutorService URLs here.

# Local development with a separately running BFF:
VITE_BFF_BASE_URL=http://localhost:8080
VITE_BFF_API_PREFIX=/api/v1
VITE_USE_MOCK_BFF=false

# Local frontend-only development without BFF:
# VITE_USE_MOCK_BFF=true

# Docker Compose / VPS deployment:
# If Nginx serves Site and proxies /api/v1/** to BFF on the same public origin,
# keep VITE_BFF_BASE_URL empty so browser requests stay same-origin.
# VITE_BFF_BASE_URL=
# VITE_BFF_API_PREFIX=/api/v1
# VITE_USE_MOCK_BFF=false
# STUDYBYTES_BACKEND_NETWORK=studybytes-backend
# SITE_HOST_BIND=127.0.0.1
# SITE_HOST_PORT=3000

# If BFF is exposed on a separate public origin:
# VITE_BFF_BASE_URL=https://api.studybytes.example.com
# VITE_BFF_API_PREFIX=/api/v1
# VITE_USE_MOCK_BFF=false
# STUDYBYTES_BACKEND_NETWORK=studybytes-backend
# SITE_HOST_BIND=127.0.0.1
# SITE_HOST_PORT=3000
